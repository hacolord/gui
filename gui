    local function safeLoad(url, name)
        task.spawn(function()
            local loadSuccess, loadErr = pcall(function()
                if not req then return end

                local response = req({
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["Authorization"] = "token " .. token,
                        ["Accept"] = "application/vnd.github.v3.raw",
                        ["User-Agent"] = "RobloxApp/LuaApp"
                    }
                })

                if response and response.Success then
                    if response.Body and response.Body ~= "" then
                        local func, parseErr = loadstring(response.Body)
                        if func then 
                            func() 
                        else
                            warn("Lỗi cú pháp trong module " .. name .. ": " .. tostring(parseErr))
                        end
                    end
                end
            end)
            if not loadSuccess then
                warn("Lỗi tải module " .. name .. ": " .. tostring(loadErr))
            end
        end)
    end

