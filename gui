local PlayerTab = Window:CreateTab("Danh Sách Mục Tiêu", 4483362458)
local PlayerDropdown, PinnedDropdown, Drop_AvoidList, Drop_KillAllExceptions

local function updatePlayers()
    local playerNames, nameToPlayer = {}, {}
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= localPlayer then
            local displayNameStr = v.DisplayName .. " (" .. v.Name .. ")"
            table.insert(playerNames, displayNameStr)
            nameToPlayer[displayNameStr] = v
        end
    end
    _G.HubState.nameToPlayer = nameToPlayer
    if PlayerDropdown then PlayerDropdown:Refresh(playerNames, true) end
    if PinnedDropdown then PinnedDropdown:Refresh(playerNames, true) end
    if Drop_AvoidList then Drop_AvoidList:Refresh(playerNames, true) end
    if Drop_KillAllExceptions then Drop_KillAllExceptions:Refresh(playerNames, true) end
end

PlayerDropdown = PlayerTab:CreateDropdown({
   Name = "Chọn mục tiêu (Mục tiêu đơn)", Options = {}, CurrentOption = {""}, MultipleOptions = false,
   Callback = function(Option)
      local targetName = type(Option) == "table" and Option[1] or Option
      local p = _G.HubState.nameToPlayer and _G.HubState.nameToPlayer[targetName]
      if p then
         if _G.HubState.isNearTrackingActive then return end
         _G.HubState.selectedTargetPlayer = p
         if _G.HubState.isClassicTrackingActive and _G.HubLogic.StartFlying then _G.HubLogic.StartFlying("Classic") end
      end
   end,
})

PinnedDropdown = PlayerTab:CreateDropdown({
    Name = "Danh sách ghim (Ghim 1 ném 1, Ghim nhiều ném nhiều)", Options = {}, CurrentOption = {}, MultipleOptions = true,
    Callback = function(Options)
        local selectedNames = type(Options) == "table" and Options or {Options}
        _G.HubState.pinnedPlayers = {}
        for _, nameStr in ipairs(selectedNames) do
            local p = _G.HubState.nameToPlayer and _G.HubState.nameToPlayer[nameStr]
            if p then _G.HubState.pinnedPlayers[p] = true end
        end
        if _G.HubLogic.UpdatePinnedOrder then _G.HubLogic.UpdatePinnedOrder() end
        if _G.HubLogic.HasPinnedPlayers and _G.HubLogic.HasPinnedPlayers() then
            if _G.HubState.isClassicTrackingActive then
                if not _G.HubState.selectedTargetPlayer or not _G.HubState.pinnedPlayers[_G.HubState.selectedTargetPlayer] then
                    _G.HubState.selectedTargetPlayer = _G.HubState.pinnedOrder and _G.HubState.pinnedOrder[_G.HubState.currentPinnedIndex or 1]
                end
            end
        end
    end,
})

updatePlayers()
PlayerTab:CreateButton({ Name = "Làm mới danh sách (Refresh)", Callback = updatePlayers })

Players.PlayerRemoving:Connect(function(player)
    if _G.HubState.pinnedPlayers and _G.HubState.pinnedPlayers[player] then 
        _G.HubState.pinnedPlayers[player] = nil 
        if _G.HubLogic.UpdatePinnedOrder then _G.HubLogic.UpdatePinnedOrder() end
    end
    if _G.HubState.avoidTargets and _G.HubState.avoidTargets[player] then
        _G.HubState.avoidTargets[player] = nil
    end
    if _G.HubState.killAllExceptions and _G.HubState.killAllExceptions[player] then
        _G.HubState.killAllExceptions[player] = nil
    end
    if _G.HubState.selectedTargetPlayer == player then
        if not (_G.HubState.isClassicTrackingActive and ((_G.HubState.tanSatMode == 1 or _G.HubState.tanSatMode == 3) or (_G.HubLogic.HasPinnedPlayers and _G.HubLogic.HasPinnedPlayers()))) then 
            if _G.HubLogic.StopFlying then _G.HubLogic.StopFlying() end
        end
    end
    task.wait(0.5); updatePlayers()
end)

Players.PlayerAdded:Connect(function(p)
    task.wait(0.5); updatePlayers()
end)


