    -- Hàm tự động quét Workspace JJS để xác định nhân vật của Target
    local function detectJJSCharacter(targetPlayer)
        if not targetPlayer then return "Chưa chọn người chơi" end
        local tChar = targetPlayer.Character or Workspace:FindFirstChild(targetPlayer.Name)
        if not tChar then return "Không tìm thấy nhân vật trong Workspace" end

        -- Dò tìm các folder/skil effect/moveset đặc trưng của JJS trong Workspace và Character
        local searchContainer = {tChar, Workspace}
        local foundSkills = {}

        for _, container in ipairs(searchContainer) do
            for _, obj in ipairs(container:GetChildren()) do
                local name = obj.Name:lower()
                if name:find("gojo") or name:find("lapse blue") or name:find("reversal red") or name:find("hollow purple") or name:find("infinity") or name:find("unlimited void") then
                    return "Gojo Satoru (Honored One / Six Eyes)"
                elseif name:find("sukuna") or name:find("dismantle") or name:find("cleave") or name:find("malevolent shrine") or name:find("fire arrow") or name:find("fuga") then
                    return "Ryomen Sukuna (King of Curses)"
                elseif name:find("megumi") or name:find("ten shadows") or name:find("mahoraga") or name:find("nue") or name:find("divine dog") then
                    return "Megumi Fushiguro (Ten Shadows)"
                elseif name:find("yuji") or name:find("divergent strike") or name:find("black flash") or name:find("crushing blow") then
                    return "Yuji Itadori (Vessel)"
                elseif name:find("yuta") or name:find("rika") or name:find("copy") or name:find("thin ice") or name:find("cursed speech") then
                    return "Yuta Okkotsu (Curse User)"
                elseif name:find("hakari") or name:find("idle death gamble") or name:find("jackpot") or name:find("pachinko") then
                    return "Kinji Hakari (Restless Gambler)"
                elseif name:find("kashimo") or name:find("lightning") or name:find("mythic amber") or name:find("electric") then
                    return "Hajime Kashimo (Thunder God)"
                elseif name:find("mahito") or name:find("idle transfiguration") or name:find("soul") or name:find("body distort") then
                    return "Mahito (Idle Transfiguration)"
                elseif name:find("todo") or name:find("boogie woogie") or name:find("swap") then
                    return "Aoi Todo (Boogie Woogie)"
                end
            end
        end

        -- Dò tìm theo trang phục hoặc Tool
        for _, item in ipairs(tChar:GetChildren()) do
            if item:IsA("Tool") then
                local toolName = item.Name:lower()
                if toolName:find("dismantle") or toolName:find("cleave") then return "Ryomen Sukuna" end
                if toolName:find("blue") or toolName:find("red") or toolName:find("purple") then return "Gojo Satoru" end
                if toolName:find("black flash") then return "Yuji Itadori" end
            end
        end

        return "Nhân vật mặc định / Chưa tung chiêu (Dự đoán: Cận chiến JJS)"
    end

