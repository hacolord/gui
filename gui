-- LOGIC XỬ LÝ ESP ITEM THEO THỜI GIAN THỰC TRONG WORKSHOP/ITEMS
local function removeEspFromItem(item)
    if espItemCache[item] then
        if espItemCache[item].highlight then espItemCache[item].highlight:Destroy() end
        if espItemCache[item].billboard then espItemCache[item].billboard:Destroy() end
        espItemCache[item] = nil
    end
end

local function applyEspToItem(item)
    if not item or not _G.HubState.espItemsEnabled then return end
    if espItemCache[item] then removeEspFromItem(item) end

    local targetPart = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not targetPart then return end

    local cacheData = {}

    -- Highlight (Glow)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Item_Highlight"
    highlight.Adornee = item
    highlight.FillColor = Color3.fromRGB(0, 255, 127)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = _G.HubState.espItemsGlow
    highlight.Parent = item
    cacheData.highlight = highlight

    -- BillboardGui (Name)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Item_Name"
    billboard.Adornee = targetPart
    billboard.Size = UDim2.new(0, 100, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = _G.HubState.espItemsName

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = item.Name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.Parent = billboard

    billboard.Parent = targetPart
    cacheData.billboard = billboard

    espItemCache[item] = cacheData
end

local function clearAllEspItems()
    for item, _ in pairs(espItemCache) do
        removeEspFromItem(item)
    end
    espItemCache = {}
    if espItemConnection then
        espItemConnection:Disconnect()
        espItemConnection = nil
    end
end

local function startEspItemsRealtime()
    clearAllEspItems()
    if not _G.HubState.espItemsEnabled then return end

    -- Tìm khu vực chứa items trong Workspace
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace:FindFirstChild("ItemsSpawns") or Workspace:FindFirstChild("DroppedItems") or Workspace

    -- Khởi tạo ESP cho các item đang có sẵn
    for _, child in ipairs(itemsFolder:GetChildren()) do
        if child:IsA("Tool") or child:IsA("Model") or child:IsA("BasePart") then
            if child.Name ~= "Terrain" and not Players:GetPlayerFromCharacter(child) then
                applyEspToItem(child)
            end
        end
    end

    -- Theo dõi theo thời gian thực (Thêm/Xóa)
    espItemConnection = itemsFolder.ChildAdded:Connect(function(child)
        task.wait(0.1)
        if _G.HubState.espItemsEnabled then
            applyEspToItem(child)
        end
    end)
end

-- ĐỒNG BỘ CÁC HÀM XỬ LÝ LOGIC VÀO _G.HubLogic
_G.HubLogic.SetEspItemsActive = function(enabled)
    _G.HubState.espItemsEnabled = enabled
    if enabled then
        startEspItemsRealtime()
    else
        clearAllEspItems()
    end
    local w = _G.HubState.Widgets or {}
    if w.espItemBtn then
        w.espItemBtn.Text = enabled and "ESP ITEM\nON" or "ESP ITEM\nOFF"
    end
end

_G.HubLogic.ToggleEspItems = function()
    local newState = not _G.HubState.espItemsEnabled
    _G.HubLogic.SetEspItemsActive(newState)
end

