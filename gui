    local function detectJJSCharacter(player)
        if not player then return "N/A (Chưa chọn)" end
        local char = player.Character or Workspace:FindFirstChild(player.Name)
        if not char then return "Không tìm thấy nhân vật" end

        -- Dò tìm tên skill trong Workspace nhân vật hoặc Backpack
        local detectedSkills = {}
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Folder") or child:IsA("RemoteEvent") or child:IsA("Model") then
                table.insert(detectedSkills, child.Name:lower())
            end
        end
        if player:FindFirstChild("Backpack") then
            for _, tool in ipairs(player.Backpack:GetChildren()) do
                table.insert(detectedSkills, tool.Name:lower())
            end
        end

        -- Đối chiếu với danh sách Skill JJS
        for charName, skills in pairs(JJS_CHARACTER_SKILLS) do
            for _, skill in ipairs(skills) do
                for _, detected in ipairs(detectedSkills) do
                    if detected:find(skill:lower()) then
                        return charName .. " [Khớp skill: " .. skill .. "]"
                    end
                end
            end
        end

        -- Dò theo thuộc tính Value hoặc Model Name
        local charValue = char:FindFirstChild("CharacterName") or char:FindFirstChild("Moveset")
        if charValue then return tostring(charValue.Value) end

        return "Cơ bản / Không xác định (JJS)"
    end

    local function safeLoad(url, name)
        task.spawn(function()
            local loadSuccess, loadErr = pcall(function()
                if not req then return end
                local response = req({
