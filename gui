                    Headers = {
                        ["Authorization"] = "token " .. token,
                        ["Accept"] = "application/vnd.github.v3.raw",
                        ["User-Agent"] = "RobloxApp/LuaApp"
                    }
                })
                if response and response.Success and response.Body ~= "" then
                    local func, parseErr = loadstring(response.Body)
                    if func then func() else warn("Lỗi cú pháp module " .. name .. ": " .. tostring(parseErr)) end
                end
            end)
            if not loadSuccess then warn("Lỗi tải module " .. name .. ": " .. tostring(loadErr)) end
        end)
    end

