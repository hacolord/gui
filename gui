-- Load external modules
local function safeLoad(url, name)
    local success, err = pcall(function()
        if not req then
            error("Executor không hỗ trợ hàm request!")
        end

        local response = req({
            Url = url,
            Method = "GET",
            Headers = {
                ["Authorization"] = "token " .. token,
                ["Accept"] = "application/vnd.github.v3.raw",
                ["User-Agent"] = "RobloxApp/LuaApp"
            }
        })

        if response and response.Success then
            if response.Body and response.Body ~= "" then
                local func, loadErr = loadstring(response.Body)
                if func then 
                    func() 
                else
                    warn("Lỗi cú pháp trong module " .. name .. ": " .. tostring(loadErr))
                end
            else
                warn("Nội dung tải về của module " .. name .. " bị rỗng!")
            end
        else
            local statusCode = response and response.StatusCode or "Unknown"
            warn("Lỗi HTTP (" .. tostring(statusCode) .. ") khi tải module " .. name)
        end
    end)
    if not success then
        warn("Lỗi tải module " .. name .. ": " .. tostring(err))
    end
end

