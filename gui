local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            table.insert(names, p.Name)
        end
    end
    if #names == 0 then table.insert(names, "Không có người chơi") end
    return names
end

local Drop_AvoidList = MiscTab:CreateDropdown({
    Name = "Danh Sách Tránh Né (Avoid List)",
    Options = getPlayerNames(),
    CurrentOption = {},
    MultipleOptions = true,
    Callback = function(Options)
        local selectedList = type(Options) == "table" and Options or {Options}
        _G.HubState.avoidTargets = {}
        for _, name in ipairs(selectedList) do
            local p = Players:FindFirstChild(name)
            if p then
                _G.HubState.avoidTargets[p] = true
            end
        end
    end,
})

local Drop_AvoidMode = MiscTab:CreateDropdown({
